# Shop desk — no Stripe secrets belong in this repository.
# Point at the live shop or a local GoldenGooseTools checkout.
NEXT_PUBLIC_SHOP_ORIGIN=https://www.goldengoosetools.com

# Prices mirrored from shop config / parameter store.
# The numbers below are Cos examples only ($29 alone / $19 with a report).
# They are not a source of truth. Leave unset if the shop has not published keys yet.
NEXT_PUBLIC_PRICE_CENTS=2900
NEXT_PUBLIC_PRICE_WITH_REPORT_CENTS=1900

# Serve this app under the shop path. Leave empty for local standalone (`/`).
# For goldengoosetools.com/tools/accessibility-statement set:
# NEXT_PUBLIC_BASE_PATH=/tools/accessibility-statement
NEXT_PUBLIC_BASE_PATH=

# Default standard shown when a report does not name one.
# This is a target, not a conformance claim. Date last checked is shown on the page.
NEXT_PUBLIC_STANDARD=WCAG 2.2 Level AA
NEXT_PUBLIC_STANDARD_CHECKED=2026-09-19

# Local-only unlock when the shop desk is not configured. Never enable in production.
NEXT_PUBLIC_ALLOW_LOCAL_UNLOCK=true

# Next-tool links
NEXT_PUBLIC_NEXT_TOOL_CHECK=https://www.goldengoosetools.com/tools/accessibility-check
NEXT_PUBLIC_NEXT_TOOL_FIX=
